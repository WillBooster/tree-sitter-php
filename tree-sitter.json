{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "php",
      "camelcase": "PHP",
      "scope": "source.php",
      "path": "php",
      "external-files": ["common/scanner.h"],
      "file-types": ["php"]
    },
    {
      "name": "php_only",
      "camelcase": "PHP_Only",
      "scope": "source.php",
      "path": "php_only",
      "external-files": ["common/scanner.h"]
    }
  ],
  "metadata": {
    "version": "0.24.2",
    "license": "MIT",
    "description": "PHP grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-php"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
